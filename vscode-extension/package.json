{
  "name": "debugging-gym",
  "displayName": "Debugging Gym",
  "description": "Solve Debugging Gym exercises from VS Code: choose a problem kind, get an exercise, and verify your fix against the harness.",
  "version": "0.2.0",
  "publisher": "debugging-gym",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debuggingGym",
          "title": "Debugging Gym",
          "icon": "media/gym.svg"
        }
      ]
    },
    "views": {
      "debuggingGym": [
        {
          "type": "webview",
          "id": "debuggingGym.sidebar",
          "name": "Exercises"
        }
      ]
    },
    "commands": [
      {
        "command": "debuggingGym.newExercise",
        "title": "Debugging Gym: New exercise"
      },
      {
        "command": "debuggingGym.verifyFix",
        "title": "Debugging Gym: Verify fix against the harness"
      },
      {
        "command": "debuggingGym.showTask",
        "title": "Debugging Gym: Show task"
      }
    ],
    "configuration": {
      "title": "Debugging Gym",
      "properties": {
        "debuggingGym.baseUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL of the Debugging Gym web app."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Team8TemporaryName/Team8DebuggingGym"
  }
}