# Debugging Gym configuration. Copy to .env and fill in your values.
# Never commit a real .env; this file only shows the shape of the config.

# LLM provider (OpenAI-compatible). Leave LLM_API_KEY empty to use the
# deterministic local generator instead.
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Debug environment connection. The learner's VS Code attaches here.
DEBUG_HOST=localhost
DEBUG_PORT=5678


# OpenPanel analytics. Leave credentials empty to disable event delivery.
OPENPANEL_API_URL=https://api.openpanel.dev/track
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# Set to true when running behind HTTPS in production.
COOKIE_SECURE=false
# Server-side exercise storage and teacher access.
# Set a private, non-default value in the deployment environment.
TEACHER_KEY=replace-with-a-private-teacher-access-key
DEBUGGING_GYM_DB=./app/gym.db
